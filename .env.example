# =============================================================================
# Metaplex Agent Template -- minimal happy-path .env
#
# Copy to .env (`cp .env.example .env`) and fill the required values.
# Everything else has a sensible default. For the full catalog of tunables
# (rate limits, RPC budgets, autonomous-mode worker knobs, etc.) see
# `.env.advanced.example` and `docs/SPEC.md` §8.1.
#
# Quick start:
#   pnpm setup       # interactive: generates AGENT_KEYPAIR, prompts for the rest
#   pnpm doctor      # validates this file + RPC reachability + LLM key
#   pnpm dev:full    # runs server and chat UI together
# =============================================================================

# "public" (users sign their own txs) or "autonomous" (agent signs everything).
AGENT_MODE=public

# Agent keypair. Required in both modes. Either a base58 secret key (64 bytes)
# OR a JSON byte array like [1,2,3,...64 entries]. Generate with `pnpm setup`,
# `solana-keygen new --outfile /dev/stdout`, or any wallet's "export private key".
AGENT_KEYPAIR=

# Model identifier in `<provider>/<model>` form. Used in both modes — plumber
# uses it to route to the right upstream provider; in direct mode Mastra uses
# it to pick the AI SDK provider. Defaults to anthropic/claude-sonnet-4-5
# if unset. Examples:
#   anthropic/claude-sonnet-4-6, anthropic/claude-haiku-4-5
#   openai/gpt-5, openai/gpt-5-mini, openai/gpt-4o
#   google/gemini-2.5-pro, google/gemini-2.5-flash
# LLM_MODEL=anthropic/claude-sonnet-4-5-20250929

# -----------------------------------------------------------------------------
# Pick ONE of the two LLM/RPC modes below.
# -----------------------------------------------------------------------------

# ---- Mode A (default, BYOK-free): use a remote agent-plumber service ----
# Point at a running agent-plumber instance. Inference, image gen, Solana
# RPC, and DAS all flow through plumber, paid per-call via x402 v2.
#
# Plumber defaults to native SOL payments (cheapest setup — no token
# accounts to create, no stablecoin to acquire). It also accepts USDC or
# wSOL if its operator configures `PAYMENT_ASSET_MINT` on its side.
#
# What the template needs in this mode:
#   - PLUMBER_URL pointing at the service
#   - A small SOL balance on AGENT_KEYPAIR (devnet faucet works)
#   - NO Solana RPC — plumber acts as facilitator and submits txs for us
#   - NO tx fees — plumber sponsors network fees as the x402 feePayer
#   - NO provider API keys — plumber holds those
PLUMBER_URL=

# OPTIONAL — where x402 payments draw funds from:
#   keypair (default): the AGENT_KEYPAIR wallet pays directly.
#   pda:                the agent's mpl-core asset signer PDA pays via
#                       Execute CPI. Useful when SOL has accumulated at the
#                       PDA from other operations. Requires AGENT_ASSET_ADDRESS.
# PLUMBER_PAYMENT_SOURCE=keypair

# ---- Mode B: bring-your-own keys (escape hatch) ----
# Leave PLUMBER_URL empty and fill in one provider key (matching LLM_MODEL
# above) + a Solana RPC URL. The default RPC works for development; use a
# paid provider in production.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# SOLANA_RPC_URL=https://api.devnet.solana.com

# OPTIONAL — wallet allowlist. Comma-separated base58 pubkeys. When set in
# public mode, only listed wallets (plus the on-chain owner) can authenticate.
# Leave empty for an "open" agent that any wallet can sign in to.
WALLET_ALLOWLIST=

# OPTIONAL — autonomous mode pre-registration only. The wallet that will
# trigger the first register-agent call. After registration the on-chain
# owner takes precedence and this is no longer consulted.
# BOOTSTRAP_WALLET=

# OPTIONAL — agent persona preset. Selects the system-prompt body. Bundled:
# default, token-launch-concierge, wallet-cleanup-bot, treasury-rebalancer.
# Defaults to "default" (original template behavior). See
# packages/core/src/personas/ for definitions or add your own.
# AGENT_PERSONA=default

# OPTIONAL — bearer token for the /_dashboard endpoint. When unset, the
# dashboard is reachable from loopback only (127.0.0.1 / ::1) — fine for
# `pnpm dev`. Set to a long random string when deploying to surface the
# worker-loop snapshot remotely. Pass via the `X-Dashboard-Token: <value>`
# header. Query-string tokens (?token=) are NOT accepted — they leak via
# access logs and browser history.
# DASHBOARD_TOKEN=
